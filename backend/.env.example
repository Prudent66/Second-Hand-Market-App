# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# development | production  (production enables fail-closed security checks)
NODE_ENV=development

# Port to listen on. Cloud hosts (Render/Railway/Heroku) inject this.
PORT=5000

# Comma-separated list of allowed browser origins, or * for any.
# The Android app sends no Origin header, so this only affects web clients.
CORS_ORIGIN=*

# REQUIRED in production - 16+ chars, not a placeholder.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me

# ---------------------------------------------------------------------------
# Database (PostgreSQL). Leave blank to use the in-memory auth fallback.
# For a free managed database see Neon (https://neon.tech).
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Twilio SMS - real OTP delivery
# Console: https://console.twilio.com
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Set to true ONLY to test a production deployment before Twilio is wired up:
# the register endpoint then returns the OTP in its response and logs it.
# NEVER leave this enabled on a public production server.
ALLOW_MOCK_OTP=false

# ---------------------------------------------------------------------------
# Legacy / optional
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
