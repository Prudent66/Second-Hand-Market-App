<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    Device-to-device transfer: keep auth prefs out, allow nothing else for now.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="second_hand_market_auth/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="second_hand_market_auth/" />
    </device-transfer>
</data-extraction-rules>
